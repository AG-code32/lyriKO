      "text": "I'm alive, I'm the dead, I'm a man without a head"
    },
    {
      "startMs": 206180,
      "endMs": 211620,
      "text": "A crack in the darkness"
    },
    {
      "startMs": 211620,
      "endMs": 213260,
      "text": "A tear in the sky"
    },
    {
      "startMs": 213260,
      "endMs": 216360,
      "text": "(I'm the one in everything)"
    },
    {
      "startMs": 216360,
      "endMs": 219360,
      "text": "A narrow moment when we find ourselves"
    },
    {
      "startMs": 219360,
      "endMs": 221000,
      "text": "And all we occupy"
    },
    {
