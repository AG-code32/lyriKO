    {
      "startMs": 24580,
      "endMs": 27700,
      "text": "\"Nobody\""
    },
    {
      "startMs": 27700,
      "endMs": 32920,
      "text": "Ride in the shadows wandering beyond the frame"
    },
    {
      "startMs": 32920,
      "endMs": 39640,
      "text": "Float like a feather through space and time outside a dream"
    },
    {
      "startMs": 39640,
      "endMs": 46140,
      "text": "Pirouette with divinity in a dance we've shared before"
    },
    {
      "startMs": 46140,
      "endMs": 48340,
      "text": "\"Someone dissolution\""
    },
    {
      "startMs": 48340,
      "endMs": 52580,
      "text": "This is \"I am all\" as \"I am none\""
    },
    {
      "startMs": 52580,
      "endMs": 63500,
      "text": "Here we fly so high, no, I, no coming down"
    },
    {
      "startMs": 63500,
      "endMs": 67840,
      "text": "Shedding weight as I'm coming undone"
    },
    {
      "startMs": 67840,
      "endMs": 69520,
      "text": "All that's left converging as one"
    },
    {
      "startMs": 69520,
      "endMs": 70580,
      "text": "I am the sun"
    },
    {
      "startMs": 70580,
      "endMs": 71340,
      "text": "I am the sun"
    },
    {
      "startMs": 71340,
      "endMs": 77920,
      "text": "I'm a God, I'm awake, I'm the one in everything"
    },
    {
      "startMs": 77920,
      "endMs": 84080,
      "text": "I'm alive, I'm the dead, I'm a man without a head"
    },
    {
      "startMs": 84080,
      "endMs": 99080,
      "text": "(I'm a God, I'm awake, I'm the one in everything)"
    },
    {
      "startMs": 99080,
      "endMs": 106200,
      "text": "I walk with death in final exhalation"
    },
    {
      "startMs": 106200,
      "endMs": 108280,
      "text": "And come apart through violent separation"
    },
    {
      "startMs": 108280,
      "endMs": 110320,
      "text": "A thousand floors ascend into the ether"
    },
    {
      "startMs": 110320,
      "endMs": 113480,
      "text": "A lunatic enchanted by the reaper"
    },
    {
      "startMs": 113480,
      "endMs": 116480,
      "text": "(I'm alive, I'm the dead, I'm a man without a head)"
    },
    {
      "startMs": 116480,
      "endMs": 122860,
      "text": "And down below I leave a stranger laying lifeless as the light begins to shatter the skies"
    },
    {
      "startMs": 122860,
      "endMs": 125560,
      "text": "I ascend and leave behind the \"used to be\""
    },
    {
      "startMs": 125560,
      "endMs": 134040,
      "text": "And tear the fabric worn to cover my eyes and see"
    },
    {
      "startMs": 134040,
      "endMs": 134880,
      "text": "I see"
    },
    {
      "startMs": 134880,
      "endMs": 143840,
      "text": "I see"
    },
    {
      "startMs": 143840,
      "endMs": 145340,
      "text": "Nobody"
    },
    {
      "startMs": 145340,
      "endMs": 152300,
      "text": "Breathe in the silence, ebb and flow among the waves"
    },
    {
      "startMs": 152300,
      "endMs": 159700,
      "text": "Blur on the spectrum in light come dark in equal phase"
    },
    {
      "startMs": 159700,
      "endMs": 170740,
      "text": "All I ever was, has been and always will be"
    },
    {
      "startMs": 170740,
      "endMs": 176700,
      "text": "Here I end as I started again beyond death and borne on the wind"
    },
    {
      "startMs": 176700,
      "endMs": 180200,
      "text": "I am the sun"
    },
    {
      "startMs": 180200,
      "endMs": 181820,
      "text": "I am the sun"
    },
    {
      "startMs": 181820,
      "endMs": 195020,
