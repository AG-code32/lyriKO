import 'dart:async';
import 'dart:io';

import 'package:path_provider/path_provider.dart';
import 'package:flutter/foundation.dart';

import 'package:flutter/material.dart';
import 'package:just_audio/just_audio.dart';

import '../services/lyriko_server_client.dart';
import '../services/synced_lyrics_service.dart';

/// Private server-backed player. Does not call DISCOVER or modify song data.
class MyMusicScreen extends StatefulWidget {
  const MyMusicScreen({super.key, required this.songsListenable});

  static Future<void> preloadCatalog() => _MyMusicScreenState.preloadCatalog();

  final ValueListenable<List<SyncedLyricsSong>> songsListenable;

  @override
  State<MyMusicScreen> createState() => _MyMusicScreenState();
}

class _MyMusicScreenState extends State<MyMusicScreen> {
  // Canonical IDs are returned by FastAPI and can differ from songId in JSON.
  // Cache is shared across visits and warmed up by Home after initial load.
  static final Map<String, Map<String, Map<String, dynamic>>> _indexes = {};
  static final Map<String, Future<Map<String, Map<String, dynamic>>>> _pending = {};

  static String _identity(String artist, String title) =>
      '${artist.toLowerCase().replaceAll(RegExp(r"[^a-z0-9]+"), "")}::${title.toLowerCase().replaceAll(RegExp(r"[^a-z0-9]+"), "")}';

  static Future<Map<String, Map<String, dynamic>>> _catalog({bool force = false}) async {
    final client = LyrikoServerClient();
    final base = await client.getBaseUrl();
    if (base.isEmpty) throw StateError('Configure server URL in Settings.');
    if (!force && _indexes.containsKey(base)) return _indexes[base]!;
    if (!force && _pending.containsKey(base)) return _pending[base]!;
    final task = () async {
      final rows = await client.songs();
      final map = <String, Map<String, dynamic>>{};
      for (final row in rows) {
        final id = row['id']?.toString() ?? '';
        if (id.isEmpty) continue;
        map[_identity(row['artist']?.toString() ?? '', row['title']?.toString() ?? '')] = row;
        map['id::$id'] = row;
      }
      _indexes[base] = map;
      return map;
    }();
    _pending[base] = task;
    try { return await task; } finally { _pending.remove(base); }
  }

  static Future<void> preloadCatalog() async {
    try { await _catalog(); } catch (_) { /* The existing library remains available offline. */ }
  }

  final _server = LyrikoServerClient();
  final _player = AudioPlayer();
  final _scroll = ScrollController();
  final _search = TextEditingController();
  final List<StreamSubscription<dynamic>> _subs = [];

  List<SyncedLyricsSong> _songs = [];
  Map<String, Map<String, dynamic>> _remoteIndex = {};
  String? _selectedArtist;
  SyncedLyricsSong? _playing;
  bool _loading = false;
  bool _opening = false;
  String? _error;
  int _positionMs = 0;
  Duration _duration = Duration.zero;
  double? _dragSeconds;
  bool _isPlaying = false;
  int _lastActive = -1;
  double _volume = 1.0;
  bool _mobilePlayerVisible = true;

  @override
  void initState() {
    super.initState();
    _subs.add(_player.positionStream.listen((position) {
      if (!mounted) return;
      setState(() => _positionMs = position.inMilliseconds);
      _scrollActive();
    }));
    _subs.add(_player.durationStream.listen((value) {
      if (mounted) setState(() => _duration = value ?? Duration.zero);
    }));
    _subs.add(_player.playerStateStream.listen((state) {
      if (!mounted) return;
      setState(() => _isPlaying = state.playing);
      if (state.processingState == ProcessingState.completed) {
        _next();
      }
    }));
    _songs = _sorted(widget.songsListenable.value);
    widget.songsListenable.addListener(_onHomeLibrary);
    _warmIndex();
  }

  static List<SyncedLyricsSong> _sorted(List<SyncedLyricsSong> input) {
    final result = List<SyncedLyricsSong>.from(input);
    result.sort((a, b) {
      final artist = a.artist.toLowerCase().compareTo(b.artist.toLowerCase());
      return artist != 0 ? artist : a.title.toLowerCase().compareTo(b.title.toLowerCase());
    });
    return result;
  }

  void _onHomeLibrary() {
    if (!mounted) return;
    setState(() => _songs = _sorted(widget.songsListenable.value));
  }

  Future<void> _warmIndex({bool force = false}) async {
    if (_loading) return;
    setState(() { _loading = true; _error = null; });
    try {
      final index = await _catalog(force: force);
      if (mounted) setState(() => _remoteIndex = index);
    } catch (e) {
      if (mounted) setState(() => _error = 'Server song index unavailable: $e');
    } finally {
      if (mounted) setState(() => _loading = false);
    }
  }

  Future<void> _refresh() async {
    // Refresh only when explicitly requested, while preserving the visible list.
    await _warmIndex(force: true);
  }

  Future<void> _play(SyncedLyricsSong song) async {
    if (_opening) return;
    setState(() { _opening = true; _error = null; });
    try {
      var entry = _remoteIndex[_identity(song.artist, song.title)] ?? _remoteIndex['id::${song.songId}'];
      if (entry == null) {
        _remoteIndex = await _catalog(force: true);
        entry = _remoteIndex[_identity(song.artist, song.title)] ?? _remoteIndex['id::${song.songId}'];
      }
      if (entry == null) throw StateError('Song has no matching server entry. Refresh the index.');
      if (entry['audioAvailable'] != true) throw StateError('MP3 unavailable on Windows server.');
      final id = entry['id']?.toString() ?? '';
      if (id.isEmpty) throw StateError('Server ID missing.');
      final mp3 = await _cachedAudio(entry, id);
      await _player.stop();
      // Local file playback does not start just_audio's HTTP header proxy.
      await _player.setFilePath(mp3.path);
      if (!mounted) return;
      setState(() {
        _playing = song;
        _mobilePlayerVisible = true;
        _positionMs = 0;
        _lastActive = -1;
        _dragSeconds = null;
      });
      unawaited(_player.play());
    } catch (e) {
      if (mounted) setState(() => _error = 'Could not play ${song.title}: $e');
    } finally {
      if (mounted) setState(() => _opening = false);
    }
  }

  // Downloads authenticated MP3s to the app's private, persistent cache.
  // just_audio's authenticated URL proxy binds to 127.0.0.1, which may
  // fail in a sandboxed macOS Release build. Playing a local file avoids it.
  static String _cacheKey(String value) {
    // Stable FNV-1a 64-bit digest; this is an identifier, not a security hash.
    var hash = 0xcbf29ce484222325;
    for (final unit in value.codeUnits) {
      hash ^= unit;
      hash = (hash * 0x100000001b3) & 0xffffffffffffffff;
    }
    return hash.toRadixString(16).padLeft(16, '0');
  }

  Future<File> _cachedAudio(Map<String, dynamic> entry, String id) async {
    final url = await _server.audioUrl(id);
    final token = await _server.getAuthToken();
    if (token.isEmpty) throw StateError('Missing server token.');

    final support = await getApplicationSupportDirectory();
    final directory = Directory('${support.path}/LyriKO/PrivateAudio');
    await directory.create(recursive: true);
    // A stable revision prevents accidental cross-song or cross-server reuse.
    // Prefer the server's audio revision when present; lyrics version is a
    // fallback only (it does not prove that the MP3 is unchanged).
    final base = await _server.getBaseUrl();
    final revision = entry['audioRevision'] ?? entry['audio_revision'] ??
        entry['audioModified'] ?? entry['audioSize'] ??
        entry['version'] ?? 'unversioned';
    final key = _cacheKey('$base\n$id\n$revision');
    final file = File('${directory.path}/$key.mp3');
    if (await file.exists() && await file.length() > 4096) return file;

    final partial = File('${file.path}.partial');
    HttpClient? client;
    IOSink? sink;
    try {
      client = HttpClient()..connectionTimeout = const Duration(seconds: 20);
      final request = await client.getUrl(Uri.parse(url));
      request.headers.set(HttpHeaders.authorizationHeader, 'Bearer $token');
      request.headers.set(HttpHeaders.cacheControlHeader, 'no-cache');
      final response = await request.close();
      if (response.statusCode != HttpStatus.ok) {
        await response.drain<void>();
        throw HttpException('MP3 download HTTP ${response.statusCode}', uri: Uri.parse(url));
      }
      const maxBytes = 100 * 1024 * 1024;
      var downloaded = 0;
      sink = partial.openWrite();
      await for (final chunk in response) {
        downloaded += chunk.length;
        if (downloaded > maxBytes) {
          throw StateError('MP3 exceeds 100 MB cache limit.');
        }
        sink.add(chunk);
      }
      await sink.flush();
      await sink.close();
      sink = null;
      if (downloaded < 4096 ||
          (response.contentLength >= 0 && downloaded != response.contentLength)) {
        throw const FormatException('Incomplete MP3 download.');
      }
      if (await file.exists()) await file.delete();
      return await partial.rename(file.path);
    } catch (_) {
      try { await sink?.close(); } catch (_) {}
      try { if (await partial.exists()) await partial.delete(); } catch (_) {}
      rethrow;
    } finally {
      client?.close(force: true);
    }
  }

  List<SyncedLyricsSong> get _playlist => _songs;

  void _next() {
    if (_opening || _playing == null || _playlist.isEmpty) return;
    final index = _playlist.indexWhere((s) => s.songId == _playing!.songId);
    if (index < 0) return;
    unawaited(_play(_playlist[(index + 1) % _playlist.length]));
  }

  void _previous() {
    if (_opening || _playing == null || _playlist.isEmpty) return;
    final index = _playlist.indexWhere((s) => s.songId == _playing!.songId);
    if (index < 0) return;
    unawaited(_play(_playlist[(index - 1 + _playlist.length) % _playlist.length]));
  }

  int get _activeIndex {
    final lines = _playing?.lines;
    if (lines == null || lines.isEmpty) return -1;
    for (var i = lines.length - 1; i >= 0; i--) {
      if (_positionMs >= lines[i].startMs) return i;
    }
    return -1;
  }

  void _scrollActive() {
    final active = _activeIndex;
    if (active < 0 || active == _lastActive) return;
    _lastActive = active;
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!mounted || !_scroll.hasClients) return;
      final rowHeight = MediaQuery.sizeOf(context).width < 760 ? 88.0 : 76.0;
      final target = (active * rowHeight - _scroll.position.viewportDimension / 2 + rowHeight / 2)
          .clamp(0.0, _scroll.position.maxScrollExtent);
      _scroll.animateTo(target,
          duration: const Duration(milliseconds: 350), curve: Curves.easeOutCubic);
    });
  }

  Future<void> _skipSeconds(int seconds) async {
    final durationMs = _duration.inMilliseconds > 0
        ? _duration.inMilliseconds : (_playing?.durationMs ?? 0);
    final requested = _positionMs + seconds * 1000;
    await _player.seek(Duration(milliseconds: requested.clamp(0, durationMs > 0 ? durationMs : 86400000).toInt()));
    _lastActive = -1;
    _scrollActive();
  }

  String _format(Duration d) {
    final seconds = d.inSeconds.clamp(0, 86400);
    return '${seconds ~/ 60}:${(seconds % 60).toString().padLeft(2, '0')}';
  }

  @override
  void dispose() {
    for (final sub in _subs) { sub.cancel(); }
    widget.songsListenable.removeListener(_onHomeLibrary);
    _player.dispose();
    _scroll.dispose();
    _search.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final q = _search.text.toLowerCase().trim();
    final filtered = _songs.where((s) =>
        '${s.artist} ${s.title}'.toLowerCase().contains(q)).toList();
    final groups = <String, List<SyncedLyricsSong>>{};
    for (final item in filtered) {
      groups.putIfAbsent(item.artist.trim().isEmpty ? 'Unknown artist' : item.artist.trim(), () => []).add(item);
    }
    final names = groups.keys.toList();
    final activeArtist = _selectedArtist != null && names.contains(_selectedArtist)
        ? _selectedArtist! : (names.isEmpty ? '' : names.first);
    final song = _playing;
    final totalMs = _duration.inMilliseconds > 0
        ? _duration.inMilliseconds : (song?.durationMs ?? 1).clamp(1, 86400000);
    final value = (_dragSeconds ?? _positionMs / 1000).clamp(0.0, totalMs / 1000);
    final theme = Theme.of(context);

    Widget browser() => Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
      Padding(padding: const EdgeInsets.fromLTRB(18, 14, 18, 12), child: TextField(
        controller: _search, onChanged: (_) => setState(() {}),
        decoration: InputDecoration(isDense: true, prefixIcon: const Icon(Icons.search_rounded),
          hintText: 'Search your music', border: OutlineInputBorder(
            borderRadius: BorderRadius.circular(14), borderSide: BorderSide.none),
          filled: true, fillColor: theme.colorScheme.surfaceContainer),
      )),
      Padding(padding: const EdgeInsets.fromLTRB(20, 0, 20, 10), child: Row(children: [
        const Text('ARTISTS', style: TextStyle(fontSize: 11, letterSpacing: 1.6, fontWeight: FontWeight.w700)),
        const Spacer(), Text('${_songs.length} tracks', style: theme.textTheme.bodySmall),
      ])),
      SizedBox(height: 56, child: ListView(scrollDirection: Axis.horizontal,
        padding: const EdgeInsets.symmetric(horizontal: 16), children: [
          for (final artist in names)
            Padding(padding: const EdgeInsets.only(right: 8), child: ChoiceChip(
              selected: activeArtist == artist,
              label: Text('$artist  ·  ${groups[artist]!.length}'),
              onSelected: (_) => setState(() => _selectedArtist = artist),
            )),
        ])),
      Expanded(child: names.isEmpty ? const Center(child: Text('No songs found')) :
        ListView.builder(padding: const EdgeInsets.fromLTRB(12, 8, 12, 20),
          itemCount: groups[activeArtist]!.length,
          itemBuilder: (context, i) {
            final item = groups[activeArtist]![i];
            final selected = song?.songId == item.songId;
            return Padding(padding: const EdgeInsets.only(bottom: 5),
              child: Material(color: selected ? theme.colorScheme.surfaceContainerHigh
                  : Colors.transparent, borderRadius: BorderRadius.circular(14),
                child: InkWell(borderRadius: BorderRadius.circular(14),
                  onTap: _opening ? null : () => _play(item),
                  child: Padding(padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 13),
                    child: Row(children: [
                      Container(width: 40, height: 40,
                        decoration: BoxDecoration(color: theme.colorScheme.surfaceContainer,
                          borderRadius: BorderRadius.circular(12)),
                        child: Icon(selected ? Icons.graphic_eq_rounded : Icons.music_note_rounded,
                          color: theme.colorScheme.onSurfaceVariant)),
                      const SizedBox(width: 12),
                      Expanded(child: Text(item.title, maxLines: 2, overflow: TextOverflow.ellipsis,
                        style: TextStyle(fontWeight: selected ? FontWeight.w700 : FontWeight.w500))),
                      Icon(selected ? Icons.equalizer_rounded : Icons.play_arrow_rounded,
                        color: theme.colorScheme.onSurfaceVariant),
                    ])),
                ),
              ));
          })),
    ]);

    final compact = MediaQuery.sizeOf(context).width < 760;
    Widget lyrics() => song == null
        ? Center(child: Column(mainAxisSize: MainAxisSize.min, children: [
            Icon(Icons.library_music_outlined, size: 48, color: theme.colorScheme.onSurfaceVariant),
            const SizedBox(height: 16),
            const Text('Select a track to listen', style: TextStyle(fontSize: 18)),
            const SizedBox(height: 5),
            Text('Your synchronized lyrics will appear here', style: theme.textTheme.bodySmall),
          ]))
        : Column(children: [
            if (!compact) Padding(padding: const EdgeInsets.fromLTRB(20, 30, 20, 8),
              child: Column(children: [
                Text(song.title, textAlign: TextAlign.center,
                  style: theme.textTheme.headlineSmall?.copyWith(fontWeight: FontWeight.bold)),
                const SizedBox(height: 5),
                Text(song.artist, style: theme.textTheme.bodyMedium),
              ])),
            Expanded(child: ListView.builder(
              key: ValueKey(song.songId), controller: _scroll,
              padding: EdgeInsets.symmetric(horizontal: compact ? 12 : 25, vertical: compact ? 12 : 24),
              itemCount: song.lines.length,
              itemBuilder: (context, i) {
                final line = song.lines[i];
                final active = i == _activeIndex;
                final done = i < _activeIndex;
                return SizedBox(height: compact ? 88 : 76, child: Center(
                  child: _VoiceTimedLyric(
                    line: line,
                    positionMs: _positionMs,
                    active: active,
                    done: done,
                    baseColor: theme.colorScheme.onSurface,
                    direction: Directionality.of(context),
                  ),
                ));
              })),
          ]);

    Widget controls() => compact ? Padding(
      padding: const EdgeInsets.fromLTRB(8, 0, 8, 6),
      child: Column(mainAxisSize: MainAxisSize.min, children: [
        Slider(value: value, min: 0, max: (totalMs / 1000).clamp(.001, 86400.0),
          onChanged: (v) => setState(() => _dragSeconds = v),
          onChangeEnd: (v) async {
            await _player.seek(Duration(milliseconds: (v * 1000).round()));
            if (mounted) setState(() { _dragSeconds = null; _lastActive = -1; });
            _scrollActive();
          }),
        Padding(padding: const EdgeInsets.symmetric(horizontal: 12),
          child: Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
            Text(_format(Duration(milliseconds: (_dragSeconds == null ? _positionMs : (_dragSeconds! * 1000).round()))), style: theme.textTheme.labelSmall),
            Text(_format(Duration(milliseconds: totalMs)), style: theme.textTheme.labelSmall),
          ])),
        SizedBox(height: 56, child: Row(mainAxisAlignment: MainAxisAlignment.spaceEvenly, children: [
          IconButton(onPressed: _opening ? null : _previous, tooltip: 'Previous track', icon: const Icon(Icons.skip_previous_rounded)),
          IconButton(onPressed: song == null ? null : () => _skipSeconds(-5), tooltip: 'Back 5 seconds', icon: const Icon(Icons.replay_5_rounded)),
          IconButton(onPressed: _opening ? null : () async {
            if (_isPlaying) { await _player.pause(); } else { await _player.play(); }
          }, tooltip: _isPlaying ? 'Pause' : 'Play',
            icon: Icon(_isPlaying ? Icons.pause_circle_filled_rounded : Icons.play_circle_filled_rounded), iconSize: 44),
          IconButton(onPressed: song == null ? null : () => _skipSeconds(5), tooltip: 'Forward 5 seconds', icon: const Icon(Icons.forward_5_rounded)),
          IconButton(onPressed: _opening ? null : _next, tooltip: 'Next track', icon: const Icon(Icons.skip_next_rounded)),
        ])),
        SizedBox(height: 35, child: Row(mainAxisAlignment: MainAxisAlignment.center, children: [
          IconButton(onPressed: () async {
            final v = _volume > 0 ? 0.0 : 1.0;
            await _player.setVolume(v);
            if (mounted) setState(() => _volume = v);
          }, tooltip: 'Mute or unmute', icon: Icon(_volume > 0 ? Icons.volume_up_rounded : Icons.volume_off_rounded), size: 20),
          SizedBox(width: 190, child: Slider(value: _volume, min: 0, max: 1,
            onChanged: (v) { setState(() => _volume = v); unawaited(_player.setVolume(v)); })),
        ])),
      ]),
    ) : Padding(
      padding: const EdgeInsets.fromLTRB(18, 2, 18, 16),
      child: Column(mainAxisSize: MainAxisSize.min, children: [
        Slider(value: value, min: 0, max: (totalMs / 1000).clamp(.001, 86400.0),
          onChanged: (v) => setState(() => _dragSeconds = v),
          onChangeEnd: (v) async {
            await _player.seek(Duration(milliseconds: (v * 1000).round()));
            if (mounted) setState(() { _dragSeconds = null; _lastActive = -1; });
            _scrollActive();
          }),
        Row(children: [
          Text(_format(Duration(milliseconds: (_dragSeconds == null
              ? _positionMs : (_dragSeconds! * 1000).round()))), style: theme.textTheme.labelSmall),
          const Spacer(),
          IconButton(onPressed: _opening ? null : _previous, tooltip: 'Previous track',
            icon: const Icon(Icons.skip_previous_rounded)),
          IconButton(onPressed: song == null ? null : () => _skipSeconds(-5),
            tooltip: 'Back 5 seconds', icon: const Icon(Icons.replay_5_rounded)),
          const SizedBox(width: 10),
          IconButton(onPressed: _opening ? null : () async {
              if (_isPlaying) { await _player.pause(); }
              else { await _player.play(); }
            }, tooltip: _isPlaying ? 'Pause' : 'Play',
            icon: Icon(_isPlaying ? Icons.pause_circle_filled_rounded
                : Icons.play_circle_filled_rounded), iconSize: 48),
          const SizedBox(width: 10),
          IconButton(onPressed: song == null ? null : () => _skipSeconds(5),
            tooltip: 'Forward 5 seconds', icon: const Icon(Icons.forward_5_rounded)),
          IconButton(onPressed: _opening ? null : _next, tooltip: 'Next track',
            icon: const Icon(Icons.skip_next_rounded)),
          const Spacer(),
          IconButton(onPressed: () async {
            final volume = _volume > 0 ? 0.0 : 1.0;
            await _player.setVolume(volume);
            if (mounted) setState(() => _volume = volume);
          }, tooltip: _volume > 0 ? 'Mute' : 'Unmute',
            icon: Icon(_volume > 0 ? Icons.volume_up_rounded : Icons.volume_off_rounded)),
          SizedBox(width: 102, child: Slider(value: _volume, min: 0, max: 1,
            onChanged: (v) { setState(() => _volume = v); unawaited(_player.setVolume(v)); })),
          Text(_format(Duration(milliseconds: totalMs)), style: theme.textTheme.labelSmall),
        ]),
      ]));

    // Mobile: after selecting a song show only karaoke and player controls.
    // Desktop retains its two-pane library/player layout.
    final playerOnly = compact && song != null && _mobilePlayerVisible;
    return Scaffold(
      appBar: playerOnly ? null : AppBar(title: const Text('MY MUSIC'),
        actions: [IconButton(onPressed: _loading ? null : _refresh,
          tooltip: 'Refresh server index', icon: const Icon(Icons.refresh_rounded))]),
      body: SafeArea(child: Column(children: [
        if (_error != null) Padding(padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 6),
          child: Text(_error!, style: TextStyle(color: theme.colorScheme.error))),
        if (_loading) const LinearProgressIndicator(minHeight: 2),
        if (playerOnly) SizedBox(height: 42, child: Row(children: [
          IconButton(onPressed: () => setState(() => _mobilePlayerVisible = false),
            tooltip: 'Back to artists', icon: const Icon(Icons.keyboard_arrow_down_rounded)),
          const Spacer(),
          Flexible(child: Text(song.title, overflow: TextOverflow.ellipsis,
            style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w600))),
          const Spacer(),
          const SizedBox(width: 44),
        ])),
        Expanded(child: LayoutBuilder(builder: (context, c) {
          final wide = c.maxWidth >= 760;
          if (wide) return Row(children: [
            SizedBox(width: (c.maxWidth * .34).clamp(290.0, 430.0), child: browser()),
            VerticalDivider(width: 1, color: theme.dividerColor),
            Expanded(child: lyrics()),
          ]);
          if (playerOnly) return lyrics();
          return browser();
        })),
        if (compact && song != null && !playerOnly)
          ListTile(dense: true,
            leading: const Icon(Icons.graphic_eq_rounded),
            title: Text(song.title, maxLines: 1, overflow: TextOverflow.ellipsis),
            subtitle: Text(song.artist, maxLines: 1, overflow: TextOverflow.ellipsis),
            trailing: const Icon(Icons.keyboard_arrow_up_rounded),
            onTap: () => setState(() => _mobilePlayerVisible = true)),
        if (song != null && (playerOnly || !compact)) controls(),
      ])),
    );
  }
}


/// Uses the existing CTC word timestamps for a continuous left-to-right sweep.
/// It does NOT pretend that linearly interpolating a whole line follows vocals.
/// Manual line calibration shifts/scales word positions into the corrected range.
class _VoiceTimedLyric extends StatelessWidget {
  const _VoiceTimedLyric({required this.line, required this.positionMs,
    required this.active, required this.done, required this.baseColor,
    required this.direction});

  final SyncedLyricLine line;
  final int positionMs;
  final bool active;
  final bool done;
  final Color baseColor;
  final TextDirection direction;

  // Progress only belongs to the ACTIVE lyric. Other rows remain muted.
  // Word-level CTC times drive the sweep; line-level timing is a fallback.
  double _progressFor(String text) {
    final duration = line.endMs - line.startMs;
    if (positionMs <= line.startMs) return 0.0;
    if (duration <= 0 || positionMs >= line.endMs) return 1.0;

    final words = line.words
        .where((w) => w.text.trim().isNotEmpty && w.endMs > w.startMs)
        .toList();
    if (words.isEmpty) {
      // Without word timestamps, use an honest line-level approximation,
      // rather than immediately illuminating the complete line.
      return ((positionMs - line.startMs) / duration).clamp(0.0, 1.0);
    }

    final originalStart = line.originalStartMs;
    final originalLength = line.originalEndMs - originalStart;
    int adjusted(int ms) {
      if (originalLength <= 0) return line.startMs + (ms - originalStart);
      return line.startMs +
          ((ms - originalStart) * duration / originalLength).round();
    }

    final lower = text.toLowerCase();
    var searchFrom = 0;
    var previousFraction = 0.0;
    var matchedWords = 0;
    for (final word in words) {
      final token = word.text.trim().toLowerCase();
      var begin = lower.indexOf(token, searchFrom);
      // CTC can omit punctuation; try matching the alphanumeric token.
      var finishLength = token.length;
      if (begin < 0) {
        final simplified = token.replaceAll(RegExp(r"[^a-z0-9']"), '');
        if (simplified.isEmpty) continue;
        begin = lower.indexOf(simplified, searchFrom);
        finishLength = simplified.length;
      }
      if (begin < 0) continue;
      matchedWords++;
      final finish = (begin + finishLength).clamp(0, text.length);
      final startMs = adjusted(word.startMs);
      final endMs = adjusted(word.endMs);
      if (positionMs < startMs) return previousFraction;
      if (positionMs <= endMs) {
        final timeProgress = ((positionMs - startMs) /
                (endMs - startMs).clamp(1, 100000000))
            .clamp(0.0, 1.0);
        return ((begin + (finish - begin) * timeProgress) / text.length)
            .clamp(0.0, 1.0);
      }
      previousFraction = finish / text.length;
      searchFrom = finish;
    }
    // Avoid a stuck or fully-lit line if CTC tokens cannot be matched.
    if (matchedWords == 0) {
      return ((positionMs - line.startMs) / duration).clamp(0.0, 1.0);
    }
    return previousFraction.clamp(0.0, 1.0);
  }

  @override
  Widget build(BuildContext context) {
    final text = line.text;
    final strong = active;
    final mobile = MediaQuery.sizeOf(context).width < 760;
    final preferredSize = strong ? (mobile ? 32.0 : 31.0) : (mobile ? 15.0 : 18.0);
    return LayoutBuilder(builder: (context, constraints) {
      if (text.isEmpty) return const SizedBox.shrink();
      double fontSize = preferredSize;
      TextStyle style = TextStyle(fontSize: fontSize,
        fontWeight: strong ? FontWeight.w800 : FontWeight.w400);
      TextPainter measure() => TextPainter(text: TextSpan(text: text, style: style),
        textDirection: direction, maxLines: 1, textScaler: MediaQuery.textScalerOf(context))
        ..layout(maxWidth: double.infinity);
      var painter = measure();
      final width = constraints.maxWidth;
      if (painter.width > width && width > 0) {
        fontSize = (preferredSize * (width / painter.width) * .98).clamp(mobile ? 11.0 : 13.0, preferredSize);
        style = style.copyWith(fontSize: fontSize);
        painter = measure();
      }
      final textWidth = painter.width.clamp(0.0, width).toDouble();
      final xStart = (width - textWidth) / 2;
      final progress = active ? _progressFor(text) : 0.0;
      // TextPainter gives precise glyph widths for the completed prefix.
      // For the currently sung word we advance through its displayed width.
      final charPosition = (text.length * progress).clamp(0.0, text.length.toDouble());
      final chars = charPosition.floor();
      final partial = charPosition - chars;
      double prefixWidth(String value) {
        final tp = TextPainter(text: TextSpan(text: value, style: style),
          textDirection: direction, maxLines: 1, textScaler: MediaQuery.textScalerOf(context))
          ..layout(maxWidth: double.infinity);
        return tp.width;
      }
      final leftWidth = prefixWidth(text.substring(0, chars));
      final nextWidth = chars < text.length ? prefixWidth(text.substring(0, chars + 1)) : leftWidth;
      final rightEdge = xStart + leftWidth + (nextWidth - leftWidth) * partial;
      final weakColor = baseColor.withValues(alpha: active ? .32 : done ? .38 : .24);
      final baseStyle = style.copyWith(color: weakColor);
      final fillStyle = style.copyWith(color: baseColor);
      final muted = Text(text, maxLines: 1, softWrap: false,
        overflow: TextOverflow.clip, textAlign: TextAlign.center, style: baseStyle);
      // Completed and upcoming rows NEVER receive the bright overlay.
      if (!active) return SizedBox(width: width, child: Center(child: muted));
      // AudioPlayer.positionStream updates periodically rather than every frame.
      // Interpolate ONLY the visual reveal edge between real audio positions.
      // CTC word/line timestamps remain the source of truth; playback timing
      // is never changed, and non-active lines never display a bright overlay.
      return SizedBox(width: width, child: Stack(alignment: Alignment.center, children: [
        muted,
        TweenAnimationBuilder<double>(
          tween: Tween<double>(begin: 0, end: rightEdge),
          duration: const Duration(milliseconds: 185),
          curve: Curves.linear,
          builder: (context, smoothEdge, _) => ClipRect(
            clipper: _HorizontalRevealClipper(smoothEdge),
            child: SizedBox(width: width,
              child: Center(child: Text(text, maxLines: 1,
                softWrap: false, overflow: TextOverflow.clip,
                textAlign: TextAlign.center, style: fillStyle))),
          ),
        ),
      ]));
    });
  }
}

class _HorizontalRevealClipper extends CustomClipper<Rect> {
  const _HorizontalRevealClipper(this.rightEdge);
  final double rightEdge;
  @override
  Rect getClip(Size size) => Rect.fromLTWH(0, 0, rightEdge.clamp(0.0, size.width), size.height);
  @override
  bool shouldReclip(covariant _HorizontalRevealClipper oldClipper) => oldClipper.rightEdge != rightEdge;
}
